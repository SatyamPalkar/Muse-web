# EEG Stress Detection System - Environment Configuration
# Copy this file to .env.local for development or .env for production

# =============================================================================
# FRONTEND CONFIGURATION (Next.js)
# =============================================================================

# Environment
NODE_ENV=development

# EEG API Backend URL
EEG_API_URL=http://localhost:8001

# Use mock data for development (set to 'true' for frontend-only development)
USE_MOCK_EEG=true

# Next.js specific
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# =============================================================================
# BACKEND CONFIGURATION (Python FastAPI)
# =============================================================================

# EEG API Server Configuration
EEG_API_HOST=0.0.0.0
EEG_API_PORT=8001
EEG_MODE=realtime

# OSC Configuration (for Mind Monitor)
OSC_PORT=8000
OSC_HOST=0.0.0.0

# Model Configuration
MODEL_PATH=./emotion_model_new.pth
ENABLE_DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================

# Redis (for session storage in production)
REDIS_URL=redis://localhost:6379

# PostgreSQL (for persistent data storage)
DATABASE_URL=postgresql://user:password@localhost:5432/eeg_db

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Domain and SSL
DOMAIN=localhost
SSL_CERT_PATH=
SSL_KEY_PATH=

# Security
JWT_SECRET=your-jwt-secret-here
API_KEY_SECRET=your-api-key-secret-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/eeg-system.log

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================

# Sentry (error tracking)
SENTRY_DSN=

# Google Analytics
GA_TRACKING_ID=

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable hot reload
HOT_RELOAD=true

# Enable debug mode
DEBUG_MODE=true

# Mock data configuration
MOCK_DATA_INTERVAL=2000
MOCK_DATA_VARIANCE=0.3
